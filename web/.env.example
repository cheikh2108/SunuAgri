# Base de données PostgreSQL (Neon ou Hostinger)
DATABASE_URL=postgresql://user:password@host:5432/sunuagri

# Clé secrète pour les tokens JWT (générer avec : openssl rand -hex 32)
JWT_SECRET=

# Provider SMS pour les OTP (ex: Orange SMS API, Twilio, etc.)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=SunuAgri

# Stockage médias S3-compatible (Cloudflare R2 ou Backblaze B2)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=
