{
  "expo": {
    "name": "SunuAgri",
    "slug": "sunuagri",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sunuagri",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ataaba.sunuagri"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f2e14",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.ataaba.sunuagri",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
